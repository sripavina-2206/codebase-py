#include <stdio.h>

int get_start_day(int year, int month) {
    if (month < 3) { month += 12; year--; } // Adjust for Zeller's algorithm rules
    int k = year % 100, j = year / 100;
    // Zeller's Congruence formula calculation
    int day = (1 + (13 * (month + 1)) / 5 + k + k / 4 + j / 4 + 5 * j) % 7;
    return (day + 5) % 7; // Convert output map so 0 = Monday, 6 = Sunday
}

int main() {
    int year, month, days_in_month[] = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
    printf("=== QUICK TERMINAL CALENDAR ===\nEnter Year (e.g. 2026): ");
    scanf("%d", &year);
    printf("Enter Month Number (1-12): ");
    scanf("%d", &month);

    // Account for leap years
    if ((year % 4 == 0 && year % 100 != 0) || (year % 400 == 0)) days_in_month[1] = 29;

    int start_day = get_start_day(year, month);
    printf("\n  Mon  Tue  Wed  Thu  Fri  Sat  Sun\n");

    for (int i = 0; i < start_day; i++) printf("     "); // Shift to starting day column
    for (int day = 1; day <= days_in_month[month - 1]; day++) {
        printf("%5d", day);
        if ((day + start_day) % 7 == 0) printf("\n"); // Break line at end of week
    }
    printf("\n");
    return 0;
}

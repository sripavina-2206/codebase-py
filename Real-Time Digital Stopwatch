#include <stdio.h>
#include <time.h>
#include <unistd.h>

int main() {
    time_t start_time, current_time;
    char key;

    printf("=== TERMINAL STOPWATCH ===\n");
    printf("Press [Enter] to start the timer...");
    getchar(); // Wait for user input

    start_time = time(NULL);
    printf("\nStopwatch running! Press Ctrl+C to stop.\n\n");

    while (1) {
        current_time = time(NULL);
        double elapsed = difftime(current_time, start_time);

        int hours = (int)elapsed / 3600;
        int minutes = ((int)elapsed % 3600) / 60;
        int seconds = (int)elapsed % 60;

        // \r resets the cursor to the beginning of the line for a smooth rewrite
        printf("\r⏱️  Elapsed Time: %02d:%02d:%02d", hours, minutes, seconds);
        fflush(stdout); // Force instant terminal update
        sleep(1);
    }
    return 0;
}

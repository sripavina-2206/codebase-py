#include <stdio.h>

int main() {
    int choice;
    float value;

    printf("=== QUICK CONVERTER UTILITY ===\n");
    printf("1. Kilograms (kg) to Pounds (lbs)\n");
    printf("2. Celsius (°C) to Fahrenheit (°F)\n");
    printf("3. Inches (in) to Centimeters (cm)\n");
    printf("Enter your choice (1-3): ");
    scanf("%d", &choice);

    printf("Enter the numerical value to convert: ");
    scanf("%f", &value);

    switch (choice) {
        case 1:
            printf("%.2f kg = %.2f lbs\n", value, value * 2.20462);
            break;
        case 2:
            printf("%.2f °C = %.2f °F\n", value, (value * 9 / 5) + 32);
            break;
        case 3:
            printf("%.2f inches = %.2f cm\n", value, value * 2.54);
            break;
        default:
            printf("Invalid selection.\n");
    }
    return 0;
}
